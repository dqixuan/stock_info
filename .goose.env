# Goose Database Migration Configuration
# Copy this file to .goose.env.local and update with your database credentials

# Database driver (mysql, postgres, sqlite3, etc.)
GOOSE_DRIVER=mysql

# Database connection string
# MySQL format: user:password@tcp(host:port)/dbname?parseTime=true
GOOSE_DBSTRING=root:root@tcp(127.0.0.1:3306)/stock_info?parseTime=true

# Migrations directory
GOOSE_MIGRATION_DIR=./migrations
